const START = new Date(2026, 8, 7);        // 第 1 周周一 = 2026 年 9 月 7 日
const WD = ['周一','周二','周三','周四','周五','周六','周日'];
const STEPS = ['口算 5 分钟','看视频 / 复习方法','练习 15 分钟','说一句话方法'];

function addDays(base, n){ const d = new Date(base.getTime()); d.setDate(d.getDate()+n); return d; }
function dayDate(w, i){ return addDays(START, (w-1)*7 + i); }
function md(d){ return (d.getMonth()+1) + '/' + d.getDate(); }
function mdCn(d){ return (d.getMonth()+1) + '月' + d.getDate() + '日'; }
function weekRange(w){
  const a = dayDate(w,0), b = dayDate(w,6);
  if(a.getMonth() === b.getMonth()) return mdCn(a) + ' – ' + b.getDate() + '日';
  return mdCn(a) + ' – ' + mdCn(b);
}
function weekRangeShort(w){
  const a = dayDate(w,0), b = dayDate(w,6);
  return md(a) + '–' + md(b);
}
function todayInfo(){
  const now = new Date();
  const t0 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const s0 = new Date(START.getFullYear(), START.getMonth(), START.getDate());
  const diff = Math.round((t0 - s0) / 86400000);
  if(diff < 0 || diff > 83) return null;
  return { week: Math.floor(diff/7)+1, day: diff%7, date: t0 };
}

