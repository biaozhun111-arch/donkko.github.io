/* ============ 口算计时器 ============ */
let total = 300, tick = null, running = false;
const tnum = document.getElementById('tnum');
function fmt(s){ return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0'); }
function beep(){
  try{
    const ctx = new (window.AudioContext||window.webkitAudioContext)();
    [0,0.25,0.5].forEach(t=>{
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.frequency.value = 880; o.connect(g); g.connect(ctx.destination);
      o.start(ctx.currentTime+t); o.stop(ctx.currentTime+t+0.18);
    });
  }catch(e){}
}
document.getElementById('tstart').onclick = ()=>{
  if(running){
    running = false; clearInterval(tick);
    document.getElementById('tstart').textContent = '继续';
    return;
  }
  running = true;
  document.getElementById('tstart').textContent = '暂停';
  tick = setInterval(()=>{
    total--;
    tnum.textContent = fmt(Math.max(0,total));
    if(total<=0){ clearInterval(tick); running=false; total=300; tnum.textContent='05:00'; document.getElementById('tstart').textContent='开始'; beep(); alert('口算 5 分钟到啦，进入第 2 步！'); }
  },1000);
};
document.getElementById('treset').onclick = ()=>{
  clearInterval(tick); running=false; total=300;
  tnum.textContent='05:00';
  document.getElementById('tstart').textContent='开始';
};

/* ============ 云同步 ============ */
const syncPill = document.getElementById('syncStatus');
const mStatus = document.getElementById('mStatus');

function setPill(text, cls){
  syncPill.textContent = text;
  syncPill.className = 'syncpill' + (cls ? ' ' + cls : '');
}
function setMStatus(html){ mStatus.innerHTML = html; }
function lastSyncText(){
  if(!cfg.lastSync) return '尚未同步过';
  const d = new Date(cfg.lastSync);
  const p = n => String(n).padStart(2,'0');
  return '上次同步：' + (d.getMonth()+1) + '月' + d.getDate() + '日 ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
}
function refreshStatus(){
  if(!cfgReady()){
    setPill('☁️ 未连接');
    setMStatus('状态：<b>未配置云同步</b>，进度只存在这台设备的浏览器里。配置后手机 / 平板 / 电脑会自动同步。');
  }else{
    setPill('☁️ 已同步 ' + (cfg.lastSync ? new Date(cfg.lastSync).toTimeString().slice(0,5) : ''), 'ok');
    setMStatus('状态：<b>已连接</b>（空间名 <b>' + cfg.room + '</b>）<br>' + lastSyncText() + '　·　修改后约 1 秒自动上传，打开网页自动拉取。');
  }
}

function api(path, opts){
  const base = cfg.url.replace(/\/+$/,'');
  const headers = Object.assign({
    'apikey': cfg.key,
    'Authorization': 'Bearer ' + cfg.key,
    'Content-Type': 'application/json'
  }, opts && opts.headers || {});
  return fetch(base + '/rest/v1/' + path, Object.assign({}, opts, {headers: headers}));
}

async function cloudPull(silent){
  if(!cfgReady()) return;
  setPill('⇅ 同步中…', 'busy');
  try{
    const r = await api('sync_store?id=eq.' + encodeURIComponent(cfg.room) + '&select=data,updated_at', {method:'GET'});
    if(!r.ok) throw new Error('HTTP ' + r.status);
    const rows = await r.json();
    if(!rows.length){
      cfg.lastSync = Date.now(); saveCfg(); refreshStatus();
      await cloudPush(true);
      if(!silent) alert('云端还没有数据，已把这台设备的进度上传上去。');
      return;
    }
    const remote = rows[0].data || {};
    const rt = remote.updatedAt || 0;
    const lt = state.updatedAt || 0;
    if(rt > lt){
      state = Object.assign({marks:{},says:{},notes:{},steps:{},qs:{}}, remote);
      ensureShape(); saveLocal(); render();
    }
    cfg.lastSync = Date.now(); saveCfg(); refreshStatus();
    if(!silent) alert(rt > lt ? '已从云端拉取最新进度。' : '本机进度已是最新，无需拉取。');
  }catch(e){
    setPill('☁️ 同步失败', 'err');
    if(!silent) alert('从云端下载失败：' + e.message + '\n请检查 Project URL / key / 空间名，或确认已执行建表 SQL。');
    refreshStatus();
  }
}

async function cloudPush(silent){
  if(!cfgReady()) return;
  setPill('⇅ 同步中…', 'busy');
  try{
    const body = [{
      id: cfg.room,
      data: state,
      updated_at: new Date(state.updatedAt || Date.now()).toISOString()
    }];
    const r = await api('sync_store', {
      method:'POST',
      headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},
      body: JSON.stringify(body)
    });
    if(!r.ok) throw new Error('HTTP ' + r.status + ' ' + (await r.text()).slice(0,120));
    cfg.lastSync = Date.now(); saveCfg(); refreshStatus();
    if(!silent) alert('已上传到云端。');
  }catch(e){
    setPill('☁️ 同步失败', 'err');
    if(!silent) alert('上传到云端失败：' + e.message);
  }
}

let pushTimer = null;
function scheduleCloudPush(){
  if(!cfgReady()) return;
  clearTimeout(pushTimer);
  pushTimer = setTimeout(()=>{ cloudPush(true); }, 1200);
}

/* ---------- 同步码（压缩 + Base64） ---------- */
function u8ToB64(u8){
  let s = ''; const CH = 0x8000;
  for(let i=0;i<u8.length;i+=CH) s += String.fromCharCode.apply(null, u8.subarray(i, i+CH));
  return btoa(s);
}
function b64ToU8(b){
  const s = atob(b); const u = new Uint8Array(s.length);
  for(let i=0;i<s.length;i++) u[i] = s.charCodeAt(i);
  return u;
}
async function makeCode(){
  const payload = { d: state };
  if(document.getElementById('codeWithCfg').checked && cfgReady()) payload.c = cfg;
  const bytes = new TextEncoder().encode(JSON.stringify(payload));
  try{
    const cs = new CompressionStream('gzip');
    const w = cs.writable.getWriter(); w.write(bytes); w.close();
    const buf = await new Response(cs.readable).arrayBuffer();
    return 'QQ1' + u8ToB64(new Uint8Array(buf));
  }catch(e){
    return 'QQ0' + u8ToB64(bytes);
  }
}
async function readCode(code){
  code = (code || '').trim().replace(/\s+/g,'');
  if(!/^QQ[01]/.test(code)) throw new Error('同步码格式不对（应以 QQ0 或 QQ1 开头）');
  const tag = code.slice(0,3);
  let u8 = b64ToU8(code.slice(3));
  if(tag === 'QQ1'){
    const ds = new DecompressionStream('gzip');
    const w = ds.writable.getWriter(); w.write(u8); w.close();
    const buf = await new Response(ds.readable).arrayBuffer();
    u8 = new Uint8Array(buf);
  }
  return JSON.parse(new TextDecoder().decode(u8));
}

/* ---------- 弹窗交互 ---------- */
const modal = document.getElementById('cloudModal');
document.getElementById('btnCloud').onclick = ()=>{
  document.getElementById('cfgUrl').value = cfg.url || '';
  document.getElementById('cfgKey').value = cfg.key || '';
  document.getElementById('cfgRoom').value = cfg.room || '';
