    b.textContent = v===1?'✓':(v===2?'✗':'□');
  }
}
function refreshQHead(qwrap, w, i){
  if(!qwrap) return;
  const d = WEEKS[w-1].days[i];
  const arr = state.qs[id(w,i)] || [];
  let ok = 0, bad = 0;
  d.qs.forEach((_,qi)=>{ const v = arr[qi]||0; if(v===1) ok++; else if(v===2) bad++; });
  const el = qwrap.querySelector('.qc');
  if(el) el.innerHTML = '做对 <b class="g">'+ok+'</b> · 做错 <b class="r">'+bad+'</b> · 未做 '+(d.qs.length-ok-bad);
}
function commitQ(w, i, qi, qrow, val, item){
  const p = item.split('|');
  const v = judge(val, p[1]);
  const key = id(w,i);
  const arr = state.qs[key] || [];
  arr[qi] = v;
  state.qs[key] = arr;
  setQVisual(qrow, v);
  refreshQHead(qrow.closest('.qwrap'), w, i);
  updateStats();
  save();
}

