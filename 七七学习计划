  modal.classList.add('show');
};
document.getElementById('mClose').onclick = ()=> modal.classList.remove('show');
modal.onclick = (e)=>{ if(e.target === modal) modal.classList.remove('show'); };

document.getElementById('cfgSave').onclick = async ()=>{
  cfg.url = document.getElementById('cfgUrl').value.trim();
  cfg.key = document.getElementById('cfgKey').value.trim();
  cfg.room = document.getElementById('cfgRoom').value.trim();
  if(!cfgReady()){ alert('三项都要填：Project URL、anon key、空间名。'); return; }
  saveCfg(); refreshStatus();
  await cloudPull(true);
  alert(cfg.lastSync ? '连接成功，已与云端同步。' : '已保存设置。');
};
document.getElementById('cfgPush').onclick = ()=> cloudPush(false);
document.getElementById('cfgPull').onclick = ()=> cloudPull(false);
document.getElementById('cfgClear').onclick = ()=>{
  if(confirm('断开云同步并清除连接设置？（本机进度不会删除）')){
    cfg = { disabled: true }; saveCfg(); refreshStatus();
    alert('已断开云同步，进度仍保留在本机。');
  }
};
document.getElementById('sqlBox').onclick = ()=>{
  const t = document.getElementById('sqlBox').textContent;
  navigator.clipboard && navigator.clipboard.writeText(t).then(()=>alert('建表 SQL 已复制'), ()=>{});
};

document.getElementById('codeCopy').onclick = async ()=>{
  const code = await makeCode();
  document.getElementById('codeBox').value = code;
  document.getElementById('codeBox').select();
  let ok = false;
  try{ await navigator.clipboard.writeText(code); ok = true; }catch(e){}
  try{ ok = document.execCommand('copy') || ok; }catch(e){}
  alert(ok ? ('同步码已复制（' + code.length + ' 个字符），微信发给另一台设备粘贴导入即可。')
           : ('同步码已生成在下方文本框（' + code.length + ' 个字符），请手动全选复制。'));
};
document.getElementById('codeApply').onclick = async ()=>{
  const code = document.getElementById('codeBox').value;
  if(!code.trim()){ alert('先把同步码粘贴到文本框里。'); return; }
  try{
    const obj = await readCode(code);
    if(obj.c && obj.c.url && obj.c.key && obj.c.room){
      cfg = obj.c; saveCfg(); refreshStatus();
    }
    const inc = obj.d || {};
    const it = inc.updatedAt || 0, lt = state.updatedAt || 0;
    if(lt && it < lt && !confirm('同步码的时间比本机旧（' + new Date(it).toLocaleString() + '），确定要覆盖本机进度吗？')) return;
    state = Object.assign({marks:{},says:{},notes:{},steps:{},qs:{}}, inc);
    ensureShape(); saveLocal(); render();
    if(cfgReady()) await cloudPush(true);
    alert('同步码导入成功。');
  }catch(e){
    alert('同步码解析失败：' + e.message);
  }
};

/* ---------- 用链接自动配置（换设备时点开即配好） ---------- */
function applyUrlCfg(){
  try{
    const p = new URLSearchParams(location.search);
    const u = p.get('surl'), k = p.get('skey'), r = p.get('sroom');
    if(u && k && r){
      cfg = { url:u, key:k, room:r, lastSync: cfg && cfg.lastSync };
      saveCfg();
      if(history.replaceState) history.replaceState(null, '', location.pathname);
      return true;
    }
  }catch(e){}
  return false;
}
document.getElementById('cfgLink').onclick = async ()=>{
  if(!cfgReady()){ alert('先把上面三项填好并点「保存并连接」。'); return; }
  const link = location.origin + location.pathname +
    '?surl=' + encodeURIComponent(cfg.url) +
    '&skey=' + encodeURIComponent(cfg.key) +
    '&sroom=' + encodeURIComponent(cfg.room);
  let ok = false;
  try{ await navigator.clipboard.writeText(link); ok = true; }catch(e){}
  if(!ok){ try{ ok = document.execCommand('copy'); }catch(e){} }
  if(!ok){ prompt('复制下面这个链接，在其他设备打开即自动配置好云同步：', link); return; }
  alert('配置链接已复制。\n\n在手机 / 平板 / 另一台电脑打开这个链接，会自动填好云同步设置并拉取进度，不用再手填。');
};

function initSync(){
  const auto = applyUrlCfg();
  refreshStatus();
  if(cfgReady()){
    if(auto) setTimeout(()=>setMStatus('状态：<b>已从链接自动配置云同步</b>（空间名 <b>' + cfg.room + '</b>），正在拉取最新进度…'), 0);
    cloudPull(true);
  }
}

render();
initSync();
