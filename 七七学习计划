/* ============ 自动判题 ============ */
// 从答案文本里取出"可判定的数字"：
// 1) 先去掉括号备注  2) 若含等号，取最后一个等号之后（过程式答案只取结果）
function nums(s){
  s = String(s == null ? '' : s).replace(/[（(][^）)]*[）)]/g, '');
  const eq = s.lastIndexOf('=');
  if(eq >= 0) s = s.slice(eq + 1);
  const m = s.match(/-?\d+(\.\d+)?/g);
  if(m) return m.map(Number);
  // 没有阿拉伯数字 → 试试中文数字（先去掉量词，"六个"→"六"）
  const t = s.trim().replace(/[个次颗支只本张块条种套层格段根片页米厘元角斤岁时人排步位件双副把道棵朵分点]/g, '');
  const cn = cnNum(t);
  return cn === null ? [] : [cn];
}
const CNMAP = {'零':0,'一':1,'二':2,'两':2,'三':3,'四':4,'五':5,'六':6,'七':7,'八':8,'九':9};
function cnNum(s){
  if(!s) return null;
  if(/^\d+$/.test(s)) return +s;
  let m;
  if((m = s.match(/^([二三四五六七八九])?十([一二三四五六七八九])?$/)))
    return (m[1] ? CNMAP[m[1]] : 1) * 10 + (m[2] ? CNMAP[m[2]] : 0);
  if(/^[零一二两三四五六七八九]$/.test(s)) return CNMAP[s];
  return null;
}
// 纯文本答案比对：去掉标点空格后互相包含即算对
function textEq(a, b){
  const t = String(a).replace(/[（(][^）)]*[）)]/g,'')
    .replace(/[\s，。、；：！？,.;:!?"'"'《》><＞＜]/g,'').toLowerCase();
  const e = String(b).replace(/[（(][^）)]*[）)]/g,'')
    .replace(/[\s，。、；：！？,.;:!?"'"'《》><＞＜]/g,'').toLowerCase();
  if(!t || !e) return false;
  const opts = e.split(/[／\/|]/).filter(Boolean);
  return opts.some(o => o === t || t.indexOf(o) >= 0 || o.indexOf(t) >= 0);
}
// 返回 0 未做 / 1 对 / 2 错
function judge(input, expected){
  if(expected == null) return 0;
  const raw = String(expected);
  const val = String(input == null ? '' : input).trim();
  if(!val) return 0;
  const a = nums(val), b = nums(raw);
  if(!a.length) return textEq(val, raw) ? 1 : 2;   // 学生填的是文字
  if(!b.length) return 1;                          // 标准答案本身没有数字
  const sa = a.slice().sort().join(','), sb = b.slice().sort().join(',');
  if(sa === sb) return 1;                          // 完全一致
  if(a.length === 1 && a[0] === b[b.length - 1]) return 1;  // 只填了最终结果
  if(b.length <= 3 && a.every(x => b.indexOf(x) >= 0)) return 1;  // 多空题只填了其中几个
  return 2;
}
// 就地更新单题外观（不整页重绘，避免输入框失焦）
function setQVisual(qrow, v){
