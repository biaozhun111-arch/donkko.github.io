function updateStats(){
  let ok=0,warn=0,bad=0,total=0;
  WEEKS.forEach(w=>{
    const s = weekStat(w);
    ok+=s.ok; warn+=s.warn; bad+=s.bad; total+=s.total;
  });
  document.getElementById('sTotal').textContent = total;
  document.getElementById('sTotalBar').style.width = (total/72*100)+'%';
  document.getElementById('sOk').textContent = ok;
  document.getElementById('sOkBar').style.width = (total? ok/total*100:0)+'%';
  document.getElementById('sWarn').textContent = warn;
  document.getElementById('sBad').textContent = bad;
  document.getElementById('sWBar').style.width = (total? (warn+bad)/total*100:0)+'%';

  let steps = 0;
  Object.keys(state.steps || {}).forEach(k=>{
    (state.steps[k]||[]).forEach(v=>{ if(v) steps++; });
  });
  document.getElementById('sSteps').textContent = steps;
  document.getElementById('sStepsBar').style.width = (steps/288*100)+'%';

  let qOk = 0, qBad = 0, qTotal = 0;
  WEEKS.forEach(w=>w.days.forEach((d,i)=>{
    if(!d.qs) return;
    qTotal += d.qs.length;
    const a = state.qs[id(w.n,i)] || [];
    d.qs.forEach((_,qi)=>{ const v = a[qi]||0; if(v===1) qOk++; else if(v===2) qBad++; });
  }));
  document.getElementById('sQok').textContent = qOk;
  document.getElementById('sQbad').textContent = qBad;
  document.getElementById('sQBar').style.width = (qTotal? qOk/qTotal*100 : 0)+'%';

  // 连续达标周数
  let streak = 0, best = 0, cur = 0;
  WEEKS.forEach(w=>{
    const s = weekStat(w);
    if(s.total === s.need && s.rate >= 80){ cur++; best = Math.max(best,cur); }
    else cur = 0;
  });
  streak = best;
  document.getElementById('sStreak').textContent = streak;
  document.getElementById('sStreakBar').style.width = Math.min(100, streak/2*100)+'%';
  document.getElementById('unlock').classList.toggle('hidden', streak < 2);
}

