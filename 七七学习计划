function weekStat(w){
  let ok=0, warn=0, bad=0, total=0, need=0;
  w.days.forEach((d,i)=>{
    if(d.rest) return;
    need++;
    const m = state.marks[id(w.n,i)];
    if(m){ total++; if(m==='ok')ok++; else if(m==='warn')warn++; else bad++; }
  });
  return {ok,warn,bad,total,need, rate: total? Math.round(ok/total*100):0};
}

